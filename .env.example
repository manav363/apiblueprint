POSTGRES_USER=apiblueprint
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=apiblueprint

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_MINUTES=60
ENABLE_API_DOCS=false

LOG_LEVEL=INFO
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
MAX_REQUEST_BODY_SIZE_MB=5

POSTGRES_PORT=5433
BACKEND_PORT=8000
FRONTEND_PORT=5173
MOCK_PORT=4010
REDIS_PORT=6379

# Caching (Phase 5). With docker-compose, Redis backs rate limiting and the spec
# cache. Leave REDIS_URL blank to fall back to in-process stores (no Redis needed).
REDIS_URL=redis://redis:6379/0
SPEC_CACHE_TTL_SECONDS=300

DATABASE_URL=postgresql://apiblueprint:apiblueprint@db:5432/apiblueprint
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

BACKEND_URL=http://backend:8000
VITE_API_URL=http://localhost:8000
VITE_MOCK_URL=http://localhost:4010

# Observability (Phase 3)
ENVIRONMENT=development
METRICS_ENABLED=true
# Leave the Sentry DSNs blank to disable error tracking; set them to enable it.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.0
